# ==========================================
# ApplyAI - Environment Template (.env.example)
# ==========================================

# Application Ports & URLs
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/applyai_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/applyai_db?schema=public"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Service Credentials
GROQ_API_KEY="gsk_your_groq_api_key"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"
OPENAI_API_KEY="sk-your-openai-api-key"

# LiveKit Video / Interview Integration
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-domain.livekit.cloud"

# SMTP Email Configuration
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_digit_app_password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth 2.0 Identity Provider Credentials (Google, LinkedIn, Microsoft)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

MICROSOFT_CLIENT_ID="your_microsoft_client_id"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"
MICROSOFT_TENANT_ID="common"

